{
  "name": "intelliops",
  "version": "1.0.0",
  "description": "SAP IntelliOps \u2014 the cold chain guardian (HackFest 2026 prototype)",
  "scripts": {
    "setup": "node sim/generate.js --reset",
    "start": "cds-serve",
    "watch": "cds watch",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "demo": "npm run build && npm run setup && npm start",
    "test": "node --test test/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@cap-js/sqlite": "^3.1.1",
    "@sap/cds": "^10.1.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@sap/cds-dk": "^10.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      }
    }
  }
}
